# Required in Phase 3+ for structured invoice extraction.
OPENAI_API_KEY=your_api_key_here

# Override if you want to use another OpenAI model.
OPENAI_MODEL=gpt-5.4-mini

# Required in Phase 4+ for saving, listing, and chatting with invoices.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/invoice_pipeline

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum upload size in megabytes.
MAX_UPLOAD_SIZE_MB=10

# Optional on Windows if tesseract.exe is not available on PATH.
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# OCR rendering options for PDF uploads.
OCR_PDF_DPI=200
OCR_MAX_PDF_PAGES=5
